CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_HID_REMOVE_DEVICE_BONDING_ENABLED=y
CONFIG_BT_SDP_COMMON_ENABLED=y
CONFIG_BT_SDP_PAD_LEN=500
CONFIG_BT_SDP_ATTR_LEN=400
CONFIG_BT_SSP_ENABLED=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y
CONFIG_BT_BTC_TASK_STACK_SIZE=6048
CONFIG_ESPHID_TASK_SIZE_BT=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 起動を速くする。ブートローダーのログを警告以上だけにする。
# 115200bpsでは1行あたり6から10ミリ秒かかり、起動からウェイクアップを
# 始められるまでの1.2秒のうち、実測で96行ぶんがログの出力だった。
# 試行が1回外れるたびに再起動するので、ここがそのまま待ち時間になる。
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2
